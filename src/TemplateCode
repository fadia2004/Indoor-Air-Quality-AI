# Person 1: from sklearn.linear_model import LogisticRegression
# Person 2: from sklearn.tree import DecisionTreeClassifier
# Person 3: from sklearn.ensemble import RandomForestClassifier
# Person 4: from xgboost import XGBClassifier
# Person 5: from lightgbm import LGBMClassifier

# ========== CHANGE HERE ==========
from sklearn.linear_model import LogisticRegression  # ← غيري حسب model تبعك
MODEL_NAME = "Logistic Regression"  # ← غيري حسب model تبعك
MODEL_SHORT = "LR"  # ← غيري (LR, DT, RF, XGB, LGBM)
# =================================

# Visualization settings
plt.style.use('seaborn-v0_8-darkgrid')
sns.set_palette("husl")
plt.rcParams['figure.figsize'] = (10, 6)
plt.rcParams['font.size'] = 11

print(f"✅ Libraries imported successfully!")
print(f"📊 Training model: {MODEL_NAME}")

#==============================================================================
# 2. LOAD PRE-SPLIT DATA
#==============================================================================

print("\n" + "="*80)
print("LOADING DATA")
print("="*80)

# ⚠️ UPDATE THESE LINKS - حطي روابط GitHub الخاصة فيكم
X_train = pd.read_csv('YOUR_GITHUB_RAW_LINK/X_train.csv')
X_test = pd.read_csv('YOUR_GITHUB_RAW_LINK/X_test.csv')
y_train = pd.read_csv('YOUR_GITHUB_RAW_LINK/y_train.csv').squeeze()
y_test = pd.read_csv('YOUR_GITHUB_RAW_LINK/y_test.csv').squeeze()

# Display shapes
print(f"\n✅ Data loaded successfully!")
print(f"   X_train shape: {X_train.shape}")
print(f"   X_test shape:  {X_test.shape}")
print(f"   y_train shape: {y_train.shape}")
print(f"   y_test shape:  {y_test.shape}")

# Display class distribution
print(f"\n📊 Class Distribution in Training Set:")
print(y_train.value_counts().sort_index())
print(f"\n   Percentages:")
print(y_train.value_counts(normalize=True).sort_index() * 100)

# Feature names
print(f"\n📋 Features ({len(X_train.columns)}):")
print(X_train.columns.tolist())

#==============================================================================
# 3. CREATE AND TRAIN MODEL
#==============================================================================

print("\n" + "="*80)
print(f"TRAINING {MODEL_NAME.upper()}")
print("="*80)

# ========== CHANGE HERE - Create your model ==========
# Person 1: model = LogisticRegression(max_iter=1000, random_state=42)
# Person 2: model = DecisionTreeClassifier(random_state=42)
# Person 3: model = RandomForestClassifier(n_estimators=100, random_state=42)
# Person 4: model = XGBClassifier(random_state=42)
# Person 5: model = LGBMClassifier(random_state=42)

model = LogisticRegression(max_iter=1000, random_state=42)  # ← غيري هون
# =====================================================

# Train and measure time
print(f"\n⏳ Training {MODEL_NAME}...")
start_time = time.time()

model.fit(X_train, y_train)

training_time = time.time() - start_time

print(f"✅ Training completed in {training_time:.2f} seconds!")

#==============================================================================
# 4. MAKE PREDICTIONS
#==============================================================================

print("\n" + "="*80)
print("MAKING PREDICTIONS")
print("="*80)

# Predictions
y_pred = model.predict(X_test)
y_pred_proba = model.predict_proba(X_test)

print(f"✅ Predictions completed!")
print(f"   Predictions shape: {y_pred.shape}")
print(f"   Probabilities shape: {y_pred_proba.shape}")

#==============================================================================
# 5. CALCULATE METRICS
#==============================================================================

print("\n" + "="*80)
print("EVALUATION METRICS")
print("="*80)

# Class names
class_names = ['Good', 'Moderate', 'Poor']

# Overall accuracy
accuracy = accuracy_score(y_test, y_pred)

# Per-class metrics
precision = precision_score(y_test, y_pred, average=None, zero_division=0)
recall = recall_score(y_test, y_pred, average=None, zero_division=0)
f1 = f1_score(y_test, y_pred, average=None, zero_division=0)

# Print results
print(f"\n{'='*80}")
print(f"OVERALL PERFORMANCE - {MODEL_NAME}")
print(f"{'='*80}")
print(f"🎯 Accuracy: {accuracy:.4f} ({accuracy*100:.2f}%)")
print(f"⏱️  Training Time: {training_time:.2f} seconds")

print(f"\n{'='*80}")
print(f"PER-CLASS METRICS")
print(f"{'='*80}")
print(f"{'Class':<12} {'Precision':<12} {'Recall':<12} {'F1-Score':<12}")
print(f"{'-'*50}")
for i, cls in enumerate(class_names):
    print(f"{cls:<12} {precision[i]:<12.4f} {recall[i]:<12.4f} {f1[i]:<12.4f}")

# Full classification report
print(f"\n{'='*80}")
print("DETAILED CLASSIFICATION REPORT")
print(f"{'='*80}")
print(classification_report(y_test, y_pred, target_names=class_names, zero_division=0))

#==============================================================================
# 6. CONFUSION MATRIX VISUALIZATION
#==============================================================================

print("\n" + "="*80)
print("CONFUSION MATRIX")
print("="*80)

# Calculate confusion matrix
cm = confusion_matrix(y_test, y_pred)

# Plot confusion matrix
plt.figure(figsize=(10, 8))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', 
            xticklabels=class_names, yticklabels=class_names,
            cbar_kws={'label': 'Count'})
plt.title(f'Confusion Matrix - {MODEL_NAME}\nAccuracy: {accuracy:.2%}', 
          fontsize=14, fontweight='bold', pad=20)
plt.ylabel('True Label', fontsize=12, fontweight='bold')
plt.xlabel('Predicted Label', fontsize=12, fontweight='bold')
plt.tight_layout()
plt.show()

# Print confusion matrix values
print("\nConfusion Matrix:")
print(cm)
print(f"\nInterpretation:")
print(f"  Diagonal values (correct predictions): {cm.diagonal().sum()}/{cm.sum()}")
print(f"  Off-diagonal values (errors): {cm.sum() - cm.diagonal().sum()}/{cm.sum()}")

#==============================================================================
# 7. PERFORMANCE METRICS VISUALIZATION
#==============================================================================

print("\n" + "="*80)
print("PERFORMANCE VISUALIZATION")
print("="*80)

# Create metrics dataframe
metrics_df = pd.DataFrame({
    'Precision': precision,
    'Recall': recall,
    'F1-Score': f1
}, index=class_names)

# Plot metrics
fig, ax = plt.subplots(figsize=(12, 6))
metrics_df.plot(kind='bar', ax=ax, width=0.8)
plt.title(f'Performance Metrics by Class - {MODEL_NAME}', 
          fontsize=14, fontweight='bold', pad=20)
plt.ylabel('Score', fontsize=12, fontweight='bold')
plt.xlabel('Class', fontsize=12, fontweight='bold')
plt.xticks(rotation=0)
plt.legend(loc='lower right', fontsize=10)
plt.ylim(0, 1.05)
plt.grid(axis='y', alpha=0.3, linestyle='--')

# Add value labels on bars
for container in ax.containers:
    ax.bar_label(container, fmt='%.3f', padding=3, fontsize=9)

plt.tight_layout()
plt.show()

print("✅ Visualization complete!")

#==============================================================================
# 8. FEATURE IMPORTANCE (for tree-based models only)
